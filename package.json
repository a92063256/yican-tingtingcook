    "type": "git",
    "url": "git+https://github.com/a92063256/yican-tingtingcook.git"
  },
  "homepage": "https://github.com/a92063256/yican-tingtingcook#readme",
  "bugs": {
    "url": "https://github.com/a92063256/yican-tingtingcook/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
